      "granularity": "cliente",
      "fields": [
        {"field": "customer_id", "type": "INTEGER", "description": "Identificador unico del cliente"},
        {"field": "risk_category", "type": "STRING", "description": "Categoria de riesgo crediticio asignada al cliente"}
      ]
    }
  ]
